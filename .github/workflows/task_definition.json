{
  "family": "documentportaltd",
  "networkMode": "awsvpc",          
  "executionRoleArn": "arn:aws:iam::423312811971:role/ecsTaskExecutionRole",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "1024",
  "memory": "8192",
  "containerDefinitions": [
    {
      "name": "document-portal-container",
      "image": "arn:aws:ecs:ap-southeast-2:423312811971:cluster/document-portal-cluster-name",
      "cpu": 1024,
      "essential": true,
      "portMappings": [
        {
          "containerPort": 8080,
          "hostPort": 8080,
          "protocol": "tcp",
          "name": "document-portal-container-8080-tcp",
          "appProtocol": "http"
        }
      ],
      "environment": [
        {
          "name": "LANGCHAIN_PROJECT",
          "value": "DOCUMENT PORTAL"
        }
      ],
      "secrets": [
        {
          "name": "GROQ_API_KEY",
          "valueFrom": "arn:aws:secretsmanager:ap-southeast-2:423312811971:secret:document-portal-secret-5HinPH:GROQ_API_KEY"
        },
        
        {
          "name": "GOOGLE_API_KEY",
          "valueFrom": "arn:aws:secretsmanager:ap-southeast-2:423312811971:secret:document-portal-secret-5HinPH:GOOGLE_API_KEY"
        },
        {
          "name": "HUGGINGFACEHUB_API_TOKEN",
          "valueFrom": "arn:aws:secretsmanager:ap-southeast-2:423312811971:secret:document-portal-secret-5HinPH:HUGGINGFACEHUB_API_TOKEN"
        },
        {
          "name": "OPENAI_API_KEY",
          "valueFrom": "arn:aws:secretsmanager:ap-southeast-2:423312811971:secret:document-portal-secret-5HinPH:OPENAI_API_KEY"
        }
        
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/documentportaltd",
          "awslogs-region": "ap-southeast-2",
          "awslogs-stream-prefix": "ecs",
          "awslogs-create-group": "false",
          "mode": "non-blocking",
          "max-buffer-size": "25m"
        }
      }
    }
  ]
}
